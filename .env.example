#  API base URL 
REACT_APP_API_BASE_URL=https://backend.dawahbox.com/api
REACT_APP_API_ADMINISTER_BASE_URL=https://backend.dawahbox.com/administer/api
REACT_APP_DEV_API_BASE_URL=https://dev-backend.dawahbox.com/api

# Links to app
REACT_APP_GOOGLE_PLAY_URL=
REACT_APP_APPLE_STORE_URL=

# Analytics

# Sentry (Client)
# Public DSN for browser SDK (do not use server DSN here)
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
# Set by CI to match release version (e.g., commit SHA)
REACT_APP_SENTRY_RELEASE=
# Sampling (strings are fine)
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_SENTRY_PROFILES_SAMPLE_RATE=0

# Sentry (Server)
# Private DSN for Node/Express SDK
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# GitHub Actions Secrets (configure in repo settings, not in this file):
# - SENTRY_AUTH_TOKEN
# - SENTRY_ORG
# - SENTRY_PROJECT