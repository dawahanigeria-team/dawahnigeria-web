# Copy this file to .env before running the app:
#   cp .env.example .env
#
# Only REACT_APP_API_BASE_URL is required for the app to load content.
# Everything else is optional and the app runs fine without it.
#
# Never commit your .env file.

# ---------------------------------------------------------------------------
# API (required)
# ---------------------------------------------------------------------------
# Public production API. Read-only for the endpoints this app uses.
REACT_APP_API_BASE_URL=https://api.dawahnigeria.com/api

# Used only by the landing-page service (src/services/landing.service.js).
REACT_APP_API_ADMINISTER_BASE_URL=https://api.dawahnigeria.com/administer/api

# ---------------------------------------------------------------------------
# Analytics (optional) - leave blank to disable
# ---------------------------------------------------------------------------
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Error reporting (optional) - leave blank to disable
# ---------------------------------------------------------------------------
# Public browser DSN. Do not put a server-side DSN here.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=development
# Set by CI to match the release version (e.g. the commit SHA).
REACT_APP_SENTRY_RELEASE=
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_SENTRY_PROFILES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Build (optional)
# ---------------------------------------------------------------------------
# Set to false in production builds to avoid publishing source maps.
GENERATE_SOURCEMAP=true

# ---------------------------------------------------------------------------
# Configured as GitHub Actions secrets, not here:
#   SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, CLOUDFRONT_DISTRIBUTION_ID
# ---------------------------------------------------------------------------
